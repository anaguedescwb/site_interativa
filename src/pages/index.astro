---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Contact from '~/components/widgets/Contact.astro';
import Brands from '~/components/widgets/Brands.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import { WHATSAPP_URL, PHONE_DISPLAY, PHONE_HREF, ADDRESS } from '~/navigation';
import logoIcon from '~/assets/favicons/interativa-192.png';

const metadata = {
  title: 'Outsourcing e locação de impressoras em Curitiba',
  ignoreTitleTemplate: true,
};

const whatsappCta = {
  variant: 'primary' as const,
  text: 'Pedir diagnóstico gratuito',
  href: WHATSAPP_URL,
  target: '_blank',
  icon: 'tabler:brand-whatsapp',
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(logoIcon.src, SITE?.site).toString(),
    telephone: '+55 41 3013-4444',
    foundingDate: '1995',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'R. Buenos Aires, 1373',
      addressLocality: 'Curitiba',
      addressRegion: 'PR',
      addressCountry: 'BR',
    },
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero -->
  <Hero
    tagline="Managed Print Services (MPS) · Curitiba"
    actions={[
      { ...whatsappCta, text: 'Diagnóstico gratuito' },
      { text: 'Pedir proposta', href: '#proposta' },
    ]}
    image={{ src: '~/assets/images/hero-impressora.png', alt: 'Pessoa operando uma impressora multifuncional' }}
  >
    <Fragment slot="title">
      Outsourcing de impressão <span class="text-primary">para empresas</span>
    </Fragment>
    <Fragment slot="subtitle">
      Managed print services (MPS) é a Interativa cuidando de todo o seu parque: equipamentos, suprimentos, manutenção e
      gestão dos custos. Sua empresa paga por página e foca no que faz de melhor.
      <span class="mt-4 flex flex-wrap justify-center lg:justify-start gap-x-5 gap-y-1 text-base font-medium">
        <span>✓ No mercado desde 1995</span>
        <span>✓ Autorizada Xerox</span>
        <span>✓ Custo por página previsível</span>
      </span>
    </Fragment>
  </Hero>

  <!-- Formulário de proposta -->
  <Contact
    id="proposta"
    title="Receba uma proposta sob medida"
    subtitle="Conte um pouco sobre a sua operação. Retornamos com um diagnóstico e o custo por página estimado, sem compromisso."
    inputs={[
      { type: 'text', name: 'empresa', label: 'Nome da sua empresa*', autocomplete: 'organization', required: true },
      { type: 'text', name: 'nome', label: 'Nome', autocomplete: 'name' },
      { type: 'email', name: 'email', label: 'E-mail', autocomplete: 'email' },
      { type: 'tel', name: 'telefone', label: 'Telefone', autocomplete: 'tel' },
    ]}
    button="Pedir diagnóstico gratuito"
    whatsapp="Olá! Quero um diagnóstico gratuito de outsourcing de impressão."
    description="Ao enviar, abrimos o WhatsApp da Interativa com os seus dados preenchidos."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5"></div>
    </Fragment>
  </Contact>

  <!-- Marcas -->
  <Brands
    title="Trabalhamos com as principais marcas"
    boxed={false}
    icons={[]}
    images={[
      { src: '~/assets/images/brands/Brother.png', alt: 'Brother' },
      { src: '~/assets/images/brands/Canon.png', alt: 'Canon' },
      { src: '~/assets/images/brands/Hp-invent.png', alt: 'HP Invent' },
      { src: '~/assets/images/brands/Hp.png', alt: 'HP' },
      { src: '~/assets/images/brands/Lexmark.png', alt: 'Lexmark' },
      { src: '~/assets/images/brands/Ricoh.png', alt: 'Ricoh' },
      { src: '~/assets/images/brands/Samsung.png', alt: 'Samsung' },
    ]}
  />

  <!-- Problemas -->
  <Features
    id="por-que-terceirizar"
    tagline="Por que terceirizar"
    title="Gerir impressão internamente consome tempo e dinheiro"
    subtitle="Quanto maior a empresa, mais impressoras, marcas e contratos diferentes para administrar. Isso vira um custo que ninguém controla."
    columns={2}
    items={[
      {
        title: 'Parque desorganizado',
        description: 'Modelos e marcas diferentes, cada um com o seu insumo e o seu fornecedor.',
        icon: 'tabler:printer-off',
      },
      {
        title: 'TI sobrecarregada',
        description: 'Seu time de tecnologia perde horas resolvendo atolamento e driver de impressora.',
        icon: 'tabler:user-exclamation',
      },
      {
        title: 'Custo invisível',
        description: 'Sem relatório, ninguém sabe quanto cada filial ou setor gasta para imprimir.',
        icon: 'tabler:eye-off',
      },
      {
        title: 'Compra reativa',
        description: 'Toner e peça comprados na emergência saem sempre mais caro.',
        icon: 'tabler:alert-triangle',
      },
    ]}
  />

  <!-- O que a Interativa assume -->
  <Features2
    id="solucoes"
    tagline="Managed print services"
    title="O que a Interativa assume no lugar da sua empresa"
    subtitle="No MPS, a gestão do parque inteiro passa a ser nossa responsabilidade. Você acompanha os resultados; a operação fica com a gente."
    items={[
      {
        title: 'Equipamentos sob medida',
        description: 'Impressoras e multifuncionais dimensionadas para o volume de cada área.',
        icon: 'tabler:printer',
      },
      {
        title: 'Suprimentos automáticos',
        description: 'Toner e cilindro entregues antes de acabar, com base no consumo real.',
        icon: 'tabler:package',
      },
      {
        title: 'Manutenção proativa',
        description: 'Preventiva e corretiva para o equipamento não parar no fechamento.',
        icon: 'tabler:tool',
      },
      {
        title: 'Gestão de custos',
        description: 'Custo por página fechado e relatórios que mostram para onde vai cada real.',
        icon: 'tabler:report-money',
      },
      {
        title: 'Impressão segura',
        description: 'Liberação por senha ou crachá, para documento nenhum ficar esquecido na bandeja.',
        icon: 'tabler:lock',
      },
      {
        title: 'Modelo escalável',
        description: 'Dá para crescer, abrir filial ou trocar equipamento sem renegociar tudo do zero.',
        icon: 'tabler:building-skyscraper',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5"></div>
    </Fragment>
  </Features2>

  <!-- Como funciona -->
  <Steps2
    id="como-funciona"
    tagline="Como funciona"
    title="Do parque atual ao contrato de outsourcing"
    subtitle="Um caminho simples para sair de vários fornecedores e chegar a um custo por página fechado."
    callToAction={whatsappCta}
    items={[
      {
        title: '1. Levantamento do parque',
        description: 'Mapeamos cada impressora, volume e custo atual da empresa.',
        icon: 'tabler:clipboard-list',
      },
      {
        title: '2. Desenho do contrato',
        description: 'Montamos o MPS com os equipamentos certos e o custo por página.',
        icon: 'tabler:file-description',
      },
      {
        title: '3. Migração assistida',
        description: 'Instalamos, configuramos e orientamos a equipe sem parar a operação.',
        icon: 'tabler:truck-delivery',
      },
      {
        title: '4. Gestão e relatórios',
        description: 'Acompanhamos consumo, insumo e manutenção mês a mês.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- O que muda -->
  <Content
    tagline="O que muda na prática"
    title="Menos operação, mais previsibilidade"
    items={[
      {
        title: 'Previsibilidade no orçamento',
        description: 'Você sabe o custo de impressão antes do mês começar.',
      },
      {
        title: 'TI livre para o que importa',
        description: 'Sua equipe para de apagar incêndio de impressora.',
      },
      {
        title: 'Menos desperdício',
        description: 'Cotas e regras cortam a impressão desnecessária.',
      },
      {
        title: 'Contrato único',
        description: 'Um fornecedor, uma fatura e um contato para todo o parque.',
      },
    ]}
    image={{ src: '~/assets/images/hero-impressora.png', alt: 'Impressora multifuncional em escritório' }}
  >
    <Fragment slot="content">
      Com o outsourcing, a impressão deixa de ser um custo invisível e passa a ser um processo governado:
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5"></div>
    </Fragment>
  </Content>

  <!-- Diferenciais -->
  <Features
    id="diferenciais"
    title="Por que escolher a Interativa"
    columns={4}
    items={[
      {
        title: '1995',
        description: 'Ano em que começamos a atender empresas de Curitiba e região.',
        icon: 'tabler:calendar-star',
      },
      {
        title: 'Estoque',
        description: 'Peças originais em estoque próprio, para o reparo não ficar esperando fornecedor.',
        icon: 'tabler:building-warehouse',
      },
      {
        title: 'Rápido',
        description: 'Equipe organizada para atender chamados com agilidade e reduzir o tempo de máquina parada.',
        icon: 'tabler:bolt',
      },
      {
        title: '1 a 1',
        description: 'Atendimento próximo, que entende a necessidade de cada empresa.',
        icon: 'tabler:heart-handshake',
      },
    ]}
  />

  <!-- FAQ -->
  <FAQs
    id="duvidas"
    tagline="Dúvidas frequentes"
    title="Perguntas sobre outsourcing de impressão corporativo"
    schema
    items={[
      {
        title: 'O que é Managed print services (MPS)?',
        description:
          'MPS, ou outsourcing de impressão, é a terceirização da gestão do parque de impressoras. A Interativa fornece os equipamentos, os suprimentos e a manutenção, e a empresa paga por página impressa, com um contrato único no lugar de compras avulsas.',
      },
      {
        title: 'Qual a diferença entre comprar impressoras e fazer outsourcing?',
        description:
          'Ao comprar, a empresa imobiliza capital e assume a manutenção, os insumos e a troca do equipamento. No outsourcing, tudo isso fica por conta da Interativa e o custo vira um valor previsível por página.',
      },
      {
        title: 'O outsourcing serve para empresas de qualquer tamanho?',
        description:
          'Sim. O contrato é dimensionado para o volume de cada empresa, de escritórios menores a operações com várias filiais.',
      },
      {
        title: 'Como funciona o custo por página?',
        description:
          'Você paga um valor por página impressa que já inclui equipamento, suprimento e manutenção. No diagnóstico definimos esse valor com base no seu volume.',
      },
      {
        title: 'A Interativa assume as impressoras que eu já tenho?',
        description:
          'Avaliamos o seu parque atual no diagnóstico e indicamos o que vale a pena manter e o que compensa substituir por equipamento adequado ao volume.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5"></div>
    </Fragment>
  </FAQs>

  <!-- CTA final -->
  <CallToAction
    id="contato"
    actions={[whatsappCta, { variant: 'secondary', text: PHONE_DISPLAY, href: PHONE_HREF, icon: 'tabler:phone' }]}
  >
    <Fragment slot="title">Quanto o outsourcing pode reduzir do seu custo de impressão?</Fragment>
    <Fragment slot="subtitle">
      Peça um diagnóstico gratuito. Analisamos o parque da sua empresa e mostramos o custo por página que a Interativa
      consegue oferecer.
      <span class="block mt-4 text-base">{ADDRESS}</span>
    </Fragment>
  </CallToAction>
</Layout>
